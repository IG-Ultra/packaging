Source: libghostty-vt
Section: libs
Priority: optional
Maintainer: Reion Wong <reionwong@gmail.com>
# Zig 0.17 also builds it; Debian has no Zig, so it is not listed here and
# debian/libghostty-vt/fetch-zig.sh puts the pinned release on PATH.
Build-Depends: debhelper-compat (= 13)
Standards-Version: 4.7.2
Homepage: https://github.com/ghostty-org/ghostty
Rules-Requires-Root: no

Package: libghostty-vt1
Architecture: any
Multi-Arch: same
Depends: ${misc:Depends},
         ${shlibs:Depends}
Description: virtual terminal emulator library from Ghostty
 libghostty-vt parses terminal output and keeps a terminal's state: its
 screens, scrollback, modes and colours, with render state, selection,
 search and the encoding of keys, the mouse and pastes.

Package: libghostty-vt-dev
Section: libdevel
Architecture: any
Multi-Arch: same
Depends: libghostty-vt1 (= ${binary:Version}),
         ${misc:Depends}
Description: virtual terminal emulator library from Ghostty (development files)
 The headers, the static library, and the pkg-config and CMake files for
 building against libghostty-vt.
